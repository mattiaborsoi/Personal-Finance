# Copy to .env and fill in. The .env file is git-ignored.
# The backend refuses to start with placeholder secrets, so every value marked
# (required) must be replaced.

# --- Database (required) ---
DB_PASSWORD=change-me-db-password

# --- AI proxy: Settl's own LiteLLM, or one you already run ---
# Settl talks to models through a LiteLLM proxy. Pick one of the two:
#
# 1. Settl's own (the default). The "bundled-litellm" Compose profile starts a
#    LiteLLM container next to the app; provider keys go here and are read by that
#    container only, and its model list lives in litellm/config.yaml.
COMPOSE_PROFILES=bundled-litellm
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Master key of that container (any long random string).
LITELLM_MASTER_KEY=sk-local-change-me
#
# 2. One you already run. Leave COMPOSE_PROFILES empty so Settl's own container is
#    never started, and point Settl at yours (host.docker.internal reaches a proxy on
#    the same machine). Settings -> AI -> Proxy in the app can do the same later
#    without touching .env; whatever is saved there wins.
# COMPOSE_PROFILES=
# LITELLM_URL=http://host.docker.internal:4000
# LITELLM_API_KEY=sk-your-proxy-key

# --- Backend auth (required) ---
# Random secret used to sign session tokens, at least 32 characters: `openssl rand -hex 32`
SECRET_KEY=change-me-to-a-long-random-string
# Login passwords for the two roles (at least 8 characters, must differ).
# Primary has full access; secondary can only submit claims and read the settlement.
PRIMARY_PASSWORD=change-me-primary
SECONDARY_PASSWORD=change-me-secondary

# --- Provider selection ---
# LLM_PROVIDER: litellm | none      (none = deterministic rules + vector memory only, no LLM calls)
LLM_PROVIDER=litellm
# EMBEDDING_PROVIDER: litellm | hash (hash = offline deterministic embeddings, no API cost)
# Do not switch providers once merchant_memory holds rows: vector spaces are not compatible.
EMBEDDING_PROVIDER=litellm

# --- Privacy ---
# Uploaded statements are deleted from disk once ingested (their sha256 is kept for
# duplicate detection). Set to true to keep the original files under ./uploads.
KEEP_UPLOADED_FILES=false

# --- Updates (Settings -> System) ---
# Settl compares the running code with the branch on GitHub (an unauthenticated
# request to api.github.com every few minutes at most). Set to false to never
# contact GitHub; "Update now" then still works if the updater container is present.
UPDATE_CHECK=true
# UPDATE_REPO=mattiaborsoi/personal-finance
# UPDATE_BRANCH=main

# --- Backups (Settings -> System -> Backups) ---
# The backend dumps the database into the "backups" volume every night (and before
# each update), keeping 14 daily, 8 weekly and 12 monthly copies. Both are optional.
# BACKUPS_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
